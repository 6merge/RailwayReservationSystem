namespace ReservationService.Services;

public class TrainServiceClient
{
    private readonly HttpClient _httpClient;

    public TrainServiceClient(HttpClient httpClient)
    {
        _httpClient = httpClient;
    }

    public async Task<bool> TrainExistsAsync(int trainId)
    {
        var response = await _httpClient.GetAsync(
            $"api/trains/{trainId}");

        return response.IsSuccessStatusCode;
    }

    public async Task<HttpResponseMessage> GetRouteAsync(int trainId)
    {
        return await _httpClient.GetAsync(
            $"api/route-stops/train/{trainId}");
    }

    public async Task<HttpResponseMessage> GetFareAsync(
        int trainId,
        int fromStationId,
        int toStationId,
        string coachType)
    {
        return await _httpClient.GetAsync(
            $"api/fares?trainId={trainId}" +
            $"&fromStationId={fromStationId}" +
            $"&toStationId={toStationId}" +
            $"&coachType={Uri.EscapeDataString(coachType)}");
    }
}


