using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using TrainService.DTOs;
using TrainService.Services;

namespace TrainService.Controllers;

[ApiController]
[Route("api/fares")]
public class FareController : ControllerBase
{
    private readonly IFareService _fareService;

    public FareController(IFareService fareService)
    {
        _fareService = fareService;
    }

    // -------------------------
    // Public endpoints
    // -------------------------

    [HttpGet("train/{trainId}")]
    public async Task<IActionResult> GetFaresByTrain(
        int trainId)
    {
        var fares = await _fareService
            .GetFaresByTrainIdAsync(trainId);

        return Ok(fares);
    }

    [HttpGet]
    public async Task<IActionResult> GetFare(
        [FromQuery] int trainId,
        [FromQuery] int fromStationId,
        [FromQuery] int toStationId,
        [FromQuery] string coachType)
    {
        var fare = await _fareService.GetFareAsync(
            trainId,
            fromStationId,
            toStationId,
            coachType);

        return Ok(fare);
    }

    // -------------------------
    // Admin endpoint
    // -------------------------

    [Authorize(Roles = "Admin")]
    [HttpPost]
    public async Task<IActionResult> CreateFare(
        CreateFareRequest request)
    {
        var fare = await _fareService
            .CreateFareAsync(request);

        return CreatedAtAction(
            nameof(GetFare),
            new
            {
                trainId = fare.TrainId,
                fromStationId = fare.FromStationId,
                toStationId = fare.ToStationId,
                coachType = fare.CoachType
            },
            fare);
    }
}


