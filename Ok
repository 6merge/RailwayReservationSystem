private async Task ValidateFareAsync(FareAdminRequest request, int? ignoredId)
{
    Positive(request.TrainId, nameof(request.TrainId));

    if (string.IsNullOrWhiteSpace(request.From))
        throw new ArgumentException("Origin station is required.");

    if (string.IsNullOrWhiteSpace(request.To))
        throw new ArgumentException("Destination station is required.");

    if (request.From.Equals(request.To, StringComparison.OrdinalIgnoreCase))
        throw new ArgumentException("Origin and destination stations must be different.");

    if (!Enum.IsDefined(request.CoachType))
        throw new ArgumentException("Coach type is invalid.");

    if (request.Amount <= 0)
        throw new ArgumentException("Fare amount must be greater than zero.");

    await TrainOrThrow(request.TrainId);

    // Convert station names to station IDs
    var allStations = await stations.GetAllAsync();

    var fromStation = allStations.FirstOrDefault(
        s => s.Name.Equals(request.From, StringComparison.OrdinalIgnoreCase));

    var toStation = allStations.FirstOrDefault(
        s => s.Name.Equals(request.To, StringComparison.OrdinalIgnoreCase));

    if (fromStation is null)
        throw new ArgumentException($"Station '{request.From}' was not found.");

    if (toStation is null)
        throw new ArgumentException($"Station '{request.To}' was not found.");

    // These are the IDs we use internally
    var fromStationId = fromStation.Id;
    var toStationId = toStation.Id;

    var stops = await routeStops.GetByTrainIdAsync(request.TrainId);

    // KEEPING YOUR ORIGINAL STATION-ID COMPARISON
    var from = stops.FirstOrDefault(
        stop => stop.StationId == fromStationId);

    var to = stops.FirstOrDefault(
        stop => stop.StationId == toStationId);

    if (from is null || to is null || from.StopOrder >= to.StopOrder)
        throw new ArgumentException(
            "Fare stations must be an ordered segment on the train route.");

    var existingFare = await fares.GetFareAsync(
        request.TrainId,
        request.From,
        request.To,
        request.CoachType);

    if (existingFare is not null && existingFare.Id != ignoredId)
        throw new InvalidOperationException(
            "Fare already exists for this route and coach type.");
}
